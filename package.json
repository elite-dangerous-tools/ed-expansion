{
    "name": "ed-colonizacion",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@12.5.1",
    "type": "module",
    "dependencies": {
        "esbuild": "~0.28.2",
        "esbuild-css-modules-plugin": "~3.1.5",
        "react": "~19.3.0",
        "react-dom": "~19.3.0",
        "react-select": "~5.10.1"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,json,css}": [
            "prettier --double-quote --write --tab-width 4 --print-width 160 --eol=lf",
            "git add"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "scripts": {
        "prebuild": "node ./src/scripts/generate-build-version",
        "pre-commit": "lint-staged",
        "lint": "eslint \"src/**/*.{js,jsx}\" --max-warnings=0",
        "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
        "build": "node ./src/scripts/build.js",
        "dev": "node ./src/scripts/dev.js --port=4000"
    },
    " jest ": {
        " automock ": true,
        " setupFiles ": [
            "/src/prepararJest.js"
        ],
        "setupTestFrameworkScriptFile": "<rootDir>/src/prepararJest.js"
    },
    "devDependencies": {
        "prettier": "~3.9.8"
    },
    "browserslist": [
        ">0.2%",
        "not dead",
        "not ie <= 11",
        "not op_mini all"
    ]
}
